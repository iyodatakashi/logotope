{
	"compilerOptions": {
		"module": "NodeNext",
		"esModuleInterop": true,
		"moduleResolution": "nodenext",
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "lib",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2022"
	},
	"compileOnSave": true,
	"include": ["src"],
	"exclude": [
		"src/**/*.test.ts",
		"src/scripts/build-avatar-seeds.ts",
		"src/avatar/verify-avatar-generation.ts",
		"src/avatar/verify-hair-distribution.ts",
		"src/scripts/verify-avatar-sidebyside.ts"
	]
}
