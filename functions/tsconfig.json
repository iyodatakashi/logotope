{
	"compilerOptions": {
		"module": "NodeNext",
		"esModuleInterop": true,
		"moduleResolution": "nodenext",
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"outDir": "lib",
		"rootDir": "src",
		"sourceMap": true,
		"strict": true,
		"target": "ES2022"
	},
	"compileOnSave": true,
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
