{
	"name": "functions",
	"scripts": {
		"build": "tsc",
		"build:watch": "tsc --watch",
		"serve": "npm run build && firebase emulators:start --only functions",
		"shell": "npm run build && firebase functions:shell",
		"start": "npm run shell",
		"deploy": "firebase deploy --only functions",
		"logs": "firebase functions:log",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"eval:judge": "RUN_JUDGE_EVAL=1 vitest run --project eval",
		"test:integration": "cd .. && firebase emulators:exec --only firestore --project demo-logotope \"cd functions && npx vitest run --project integration\""
	},
	"engines": {
		"node": "24"
	},
	"main": "lib/index.js",
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.96",
		"@ai-sdk/google": "^3.0.0",
		"@ai-sdk/xai": "^3.0.0",
		"@anthropic-ai/sdk": "^0.101.0",
		"@tavily/core": "^0.7.0",
		"ai": "^6.0.0",
		"dayjs": "^1.11.21",
		"express": "^5.2.1",
		"firebase-admin": "^13.6.0",
		"firebase-functions": "^7.0.0",
		"nanoid": "^5.0.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/json-schema": "^7.0.15",
		"@types/supertest": "^7.2.0",
		"@vitest/coverage-v8": "^4.1.8",
		"firebase-functions-test": "^3.4.1",
		"supertest": "^7.2.2",
		"typescript": "^6.0.0",
		"vitest": "^4.1.8"
	},
	"private": true
}
