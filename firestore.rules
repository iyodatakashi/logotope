rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /topics/{topicId} {
      allow read, write: if request.auth != null;
      allow read: if resource.data.publishedAt != null;

      match /personas/{personaId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.publishedAt != null;
      }

      match /chapters/{chapterId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.publishedAt != null;

        match /engagements/{personaId} {
          allow read, write: if request.auth != null;
        }

        match /factCheck/{docId} {
          allow read, write: if request.auth != null;
        }
      }

      match /postDebateComments/{docId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.publishedAt != null;
      }

      match /editedChapters/{chapterId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.publishedAt != null;
      }

      match /editedPostDebateComments/{docId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.publishedAt != null;
      }

      match /chapterAnalysis/{docId} {
        allow read, write: if request.auth != null;
      }

      match /stakeholders/{docId} {
        allow read, write: if request.auth != null;
      }

      match /factBase/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
