rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /topics/{topicId} {
      allow read, write: if request.auth != null;
      allow read: if resource.data.published == true;

      match /personas/{personaId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.published == true;
      }

      match /chapters/{chapterId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.published == true;

        match /engagements/{personaId} {
          allow read, write: if request.auth != null;
        }
      }

      match /editedChapters/{chapterId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.published == true;
      }

      // 導入・締め・所感を統合した editorial/0（旧 postDebateComments / editedPostDebateComments / editedIntroClosing を統合）
      match /editorial/{docId} {
        allow read, write: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/topics/$(topicId)).data.published == true;
      }

      match /chapterAnalysis/{docId} {
        allow read, write: if request.auth != null;
      }

      match /stakeholders/{docId} {
        allow read, write: if request.auth != null;
      }

      match /factBase/{docId} {
        allow read, write: if request.auth != null;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
